# Copy this file to .env.local and fill in real values.
# Nothing here blocks earlier stages — see the "needed at" comment on each group.
# Never commit .env.local. Never put secrets behind NEXT_PUBLIC_ unless explicitly marked safe below.

# ── Supabase (needed: Stage 0) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sentry (needed: Stage 0) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Google OAuth (needed: Stage 2) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── MSG91 phone OTP (needed: Stage 2) ────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Cloudinary (needed: Stage 3) ─────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Remove.bg (needed: Stage 4) ──────────────────────────────────────────
REMOVEBG_API_KEY=

# ── Upstash Redis rate limiting (needed: Stage 2, reused Stage 3/7) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Razorpay (needed: Stage 7, test mode) ────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket (needed: Stage 8, sandbox) ────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

# ── Resend (needed: Stage 9) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@giftping.in

# ── OneSignal (needed: Stage 9) ──────────────────────────────────────────
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
