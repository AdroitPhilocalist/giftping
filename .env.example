# Copy this file to .env.local and fill in real values.
# Nothing here blocks earlier stages — see the "needed at" comment on each group.
# Never commit .env.local. Never put secrets behind NEXT_PUBLIC_ unless explicitly marked safe below.

# ── Supabase (needed: Stage 0) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sentry (needed: Stage 0) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Google OAuth (needed: Stage 2) ───────────────────────────────────────
# Not read by application code at all — Supabase Auth handles the OAuth exchange with Google
# server-side. Configure these in the Supabase dashboard (Authentication > Providers > Google)
# or via the Management API, not here. Redirect URI to register with Google Cloud:
# https://<project-ref>.supabase.co/auth/v1/callback
# Kept here only as a record of where to find/rotate them.

# ── MSG91 phone OTP (needed: Stage 2 — optional, cost-gated) ─────────────
# PHONE_OTP_ENABLED=false is the cost-safe default; flip to true once MSG91 is provisioned
# and the budget has room. See CLAUDE.md's cost-constraint section.
PHONE_OTP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudinary intentionally omitted — cut from scope per the cost constraint in CLAUDE.md.
# Product/vendor images use Supabase Storage (same NEXT_PUBLIC_SUPABASE_URL/keys above) + sharp
# for fixed sizes + next/image for display-time optimization. No separate account/env vars needed.

# Remove.bg intentionally omitted — cut from scope per the cost constraint in CLAUDE.md.
# Vendors upload their own finished product photos; no automated background removal.

# ── Upstash Redis rate limiting (needed: Stage 2, reused Stage 3/7) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Razorpay (needed: Stage 7, test mode) ────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
# Optional, DEV ONLY (ignored when NODE_ENV=production): point the Razorpay client at a local mock gateway for tests.
# RAZORPAY_API_BASE=http://localhost:4010

# ── Shiprocket (needed: Stage 8, sandbox) ────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
# Optional, DEV ONLY (ignored when NODE_ENV=production): point the Shiprocket client at a local mock for tests.
# SHIPROCKET_API_BASE=http://localhost:4011

# ── Resend (needed: Stage 9) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@giftping.in

# ── OneSignal (needed: Stage 9, free tier — web push only, no native app) ─
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── Cron auth (needed: Stage 9) ──────────────────────────────────────────
# Verifies requests to /app/api/cron/* actually come from Vercel's scheduler, not the
# public internet. No Railway account needed — see CLAUDE.md's cost-constraint section.
# Vercel Cron authenticates to /api/cron/* with `Authorization: Bearer $CRON_SECRET`. Use a long random string; set the SAME value in Vercel.
CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vendor bank-detail encryption (needed: Stage 4) ──────────────────────
# AES-256-GCM key (32 random bytes, base64). Server-only. LOSING IT MAKES ENCRYPTED BANK DETAILS
# UNRECOVERABLE — back it up and use the identical value in Vercel. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VENDOR_BANK_ENCRYPTION_KEY=

# Shown on the Contact page; leave blank until the client confirms real contact details
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
